#pragma once

// This #define magic lets you use the GetDiffuseLighting & GetSpecularLighting functions in this file without making them the final functions
// used in your shader. Simply #define GetDiffuseLighting & GetSpecularLighting to your custom definition before including this file
//

#ifndef GetSpecularLighting
#define GetSpecularLighting(surface, lightingData, lightIntensity, dirToLight, viewIndex)      GetSpecularLighting_Glinty(surface, lightingData, lightIntensity, dirToLight, viewIndex)
#endif

#include <Atom/Features/PBR/Microfacet/Brdf.azsli>
#include "../BasePBR/BasePBR_LightingBrdf.azsli"

#ifndef LightingData
#error LightingData must be defined before including this file.
#endif

#ifndef Surface
#error Surface must be defined before including this file.
#endif

// The Glinty BRDF is based on "Evaluating and Sampling Glinty NDFs in Constant Time"
// https://dl.acm.org/doi/10.1145/3763282
// Shadertoy source: https://www.shadertoy.com/view/tcdGDl

real2 Lambert(real3 v)
{
    return v.xy / sqrt(1. + v.z);
}

real3 NdfToDisk(real3 v, float roughness)
{
    real3 hemi = real3(v.xy / roughness, v.z);
    float denom = dot(hemi, hemi);
    real2 v_disk = Lambert(normalize(hemi)) * .5 + .5;
    float jacobian_determinant = 1. / (roughness * roughness * denom * denom);
    return real3(v_disk, jacobian_determinant);
}

float2x2 InvQuadratic(float2x2 M) {
    float D = determinant(M);
    float A = dot(M[0] / D, M[0] / D);
    float B = -dot(M[0] / D, M[1] / D);
    float C = dot(M[1] / D, M[1] / D);
    return float2x2(C, B, B, A);
}

float2x2 UvEllipsoid(float2x2 uvJacobian)
{
    float2x2 Q = InvQuadratic(transpose(uvJacobian));
    float tr = .5 * (Q[0][0] + Q[1][1]);
    float D = sqrt(max(.0, tr * tr - determinant(Q)));
    float l1 = tr - D;
    float l2 = tr + D;
    real2 v1 = real2(l1 - Q[1][1], Q[0][1]);
    real2 v2 = real2(Q[1][0], l2 - Q[0][0]);
    real2 n = 1.f / sqrt(real2(l1, l2));
    return float2x2(normalize(v1) * n.x, normalize(v2) * n.y);
}

float QueryLod(float2x2 uvJacobian, float filterSize) {
    float s0 = length(uvJacobian[0]), s1 = length(uvJacobian[1]);
    return log2(max(s0, s1) * filterSize) + pow(2., filterSize);
}

uint2 Shuffle(uint2 v)
{
    v = v * 1664525u + 1013904223u;
    v += v.yx * 1664525u;

    v = v ^ (v >> 16u);

    v += v.yx * 1664525u;
    v = v ^ (v >> 16u);
    return v;
}

real2 Rand(uint2 v)
{
    return real2(Shuffle(v)) * pow(0.5, 32.0);
}

float Normal(float2x2 cov, real2 x)
{
    float det = determinant(cov);
    float2x2 inverse = float2x2(cov._m11, -cov._m01, -cov._m10, cov._m00) / det;
    return exp(-0.5 * dot(x, mul(inverse, x))) / (sqrt(det) * 2 * PI);
}

real2 Rand2D(real2 x, real2 y, float l, uint i)
{
    uint2 ux = asuint(x), uy = asuint(y);
    uint ul = asuint(l);
    return Rand((ux >> 16u | ux << 16u) ^ uy ^ ul ^ (i * 0x124u));
}

float Rand1D(real2 x, real2 y, float l, uint i)
{
    return Rand2D(x, y, l, i).x;
}

// Bürmann series, see https://en.wikipedia.org/wiki/Error_function
float Erf(float x)
{
    float e = exp(-x * x);
    return sign(x) * 2. * sqrt((1. - e) / PI) * (sqrt(PI) * .5 + 31. / 200. * e - 341. / 8000. * e * e);
}

float CDF(float x, float mu, float sigma)
{
    return 0.5 + 0.5 * Erf((x - mu) / (sigma * sqrt(2.)));
}

float IntegrateInterval(float x, float size, float mu, float stdev, float lowerLimit, float upperLimit)
{
    return CDF(min(x + size, upperLimit), mu, stdev) - CDF(max(x - size, lowerLimit), mu, stdev);
}

float IntergrateBox(real2 x, real2 size, real2 mu, float2x2 sigma, real2 lowerLimit, real2 upperLimit)
{
    return IntegrateInterval(x.x, size.x, mu.x, sqrt(sigma[0][0]), lowerLimit.x, upperLimit.x) *
           IntegrateInterval(x.y, size.y, mu.y, sqrt(sigma[1][1]), lowerLimit.y, upperLimit.y);
}

float Compensation(real2 x_a, float2x2 sigma_a, float res_a)
{
    float containing = IntergrateBox(real2(0.5, 0.5), real2(0.5, 0.5), x_a, sigma_a, real2(0, 0), real2(1, 1));
    float explicitly_evaluated = IntergrateBox(round(x_a * res_a) / res_a, real2(1. / res_a, 1. / res_a), x_a, sigma_a, real2(0, 0), real2(1, 1));
    return containing - explicitly_evaluated;
}

float NormalDistributionGlinty(real3 h, float roughness, float microfacetRoughness, real2 uv, float2x2 uvJacobian, float N, float filterSize)
{
    float res = sqrt(N);
    real2 x_s = uv; // TODO: transform with anisotropy matrix
    real3 x_a_and_d = NdfToDisk(h, roughness);
    real2 x_a = x_a_and_d.xy;
    float d = x_a_and_d.z;

    float lambda = QueryLod(res * uvJacobian, filterSize);

    float D_filter = .0;

    for (float m = .0; m < 2.; m += 1.)
    {
        float l = floor(lambda) + m;

        float w_lambda = 1. - abs(lambda - l);
        float res_s = res * pow(2., -l);
        float res_a = pow(2., l);

        float2x2 uvJacobian2 = filterSize * uvJacobian;
        float2x2 sigma_s = uvJacobian2 * transpose(uvJacobian2);

        float2x2 sigma_a = d * pow(microfacetRoughness, 2.) * float2x2(1., .0, .0, 1.);

        real2 base_i_a = clamp(round(x_a * res_a), 1., res_a - 1.);
        for (int j_a = 0; j_a < 4; ++j_a)
        {
            real2 i_a = base_i_a + real2(int2(j_a, j_a / 2) % 2) - .5;

            real2 base_i_s = round(x_s * res_s);
            for (int j_s = 0; j_s < 4; ++j_s) {
                real2 i_s = base_i_s + real2(int2(j_s, j_s / 2) % 2) - .5;

                real2 g_s = (i_s + Rand2D(i_s, i_a, l, 1u) - .5) / res_s;
                real2 g_a = (i_a + Rand2D(i_s, i_a, l, 2u) - .5) / res_a;

                float r = Rand1D(i_s, i_a, l, 4u);
                float roulette = smoothstep(max(.0, r - .1), min(1.0, r + .1), w_lambda);

                D_filter += roulette * Normal(sigma_a, x_a - g_a) * Normal(sigma_s, x_s - g_s) / N;
            }
        }
        D_filter += w_lambda * Compensation(x_a, sigma_a, res_a);
    }

    return D_filter * d / PI;
}

real3 GetSpecularLighting_Glinty(Surface surface, LightingData lightingData, const real3 lightIntensity, const real3 dirToLight, uint viewIndex)
{
    float2 uv = surface.uv;
    float2x2 uvJacobian = float2x2(surface.uvDxDy.xy, surface.uvDxDy.zw);

    float3 dirToCamera = lightingData.dirToCamera[viewIndex];
    real3 normal = surface.GetSpecularNormal();
    real3 H = normalize(dirToLight + dirToCamera);
    real NdotH = saturate(dot(normal, H));
    real NdotL = saturate(dot(normal, dirToLight));
    real HdotV = saturate(dot(H, dirToCamera)); // Note that HdotL = HdotV, so we don't need to calculate both
    real NdotV = lightingData.GetSpecularNdotV(viewIndex);
    real3 HNS = mul(transpose(surface.TBN), H); // half vector in Tangent space

    // D, G and F from the lighting equation
    // Note: the division by (4.0 * NdotL * NdotV) is already factored out in the G function as an optimization
    float N = 8e5 * pow(10.0, surface.facetDensity * 6.0 - 2.0);
    float D = NormalDistributionGlinty(HNS, surface.roughnessA, surface.microfacetRoughness, uv, uvJacobian, N, surface.pixelFilterSize);
    float G = GeometricShadowingMaskingGGXCorrelated(NdotV, NdotL, surface.roughnessA2);
    real3 F = FresnelSchlick(HdotV, surface.specularF0);

    D = max(0.0, D);
    G = max(0.0, G);

    // Multiply with multiscattering Compensation in order to take account for several specular light bounces.
    // Note: the specific order and placement of real() here is deliberate and prevents half precision issues on mobile/Quest
    real3 specular = (real((D * G) * NdotL) * F) * lightingData.multiScatterCompensation;
    specular *= lightIntensity;
    return specular;
}
